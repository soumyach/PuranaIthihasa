    {
      "lettering_id": "p05-narration-a", "panel_id": "p05-panel-01", "reading_order": 1, "channel": "NARRATION", "speaker_id": "narrator", "badge_number": 1,
      "text": "From him rose a lotus, and upon that lotus sat Brahma.",
      "source_script_hash": "94af80a46eaf5d752bbc0206b9db7d4211d311f55f379c6ba63b12e388757d30",
      "box": {"x": 0.065, "y": 0.805, "width": 0.442, "height": 0.095}, "padding": 14, "font": {"size": 22, "minimum_size": 22}
    },
    {
      "lettering_id": "p05-narration-b", "panel_id": "p05-panel-02", "reading_order": 2, "channel": "NARRATION", "speaker_id": "narrator", "badge_number": 2,
      "text": "The flower stood above the waters like the single open eye of a world not yet remade. Brahma had no ground beneath him—only the lotus, Vishnu below, and the unbroken flood beyond.",
      "source_script_hash": "13c3a72b5b2292ac1547452b55818e046353a5c562e84305ab489f774be697d7",
      "box": {"x": 0.565, "y": 0.112, "width": 0.37, "height": 0.17}, "padding": 12, "font": {"size": 22, "minimum_size": 22}
    },
    {
      "lettering_id": "p05-narration-c", "panel_id": "p05-panel-03", "reading_order": 3, "channel": "NARRATION", "speaker_id": "narrator", "badge_number": 3,
      "text": "Vishnu slept.\n\nThe waters waited.\n\nAnd in that stillness, danger appeared.",
      "source_script_hash": "e8d838000e310275c00d9886df3314ad4e6cefb67c84906515468140e8b8f7ae",
      "box": {"x": 0.62, "y": 0.545, "width": 0.315, "height": 0.19}, "padding": 12, "font": {"size": 22, "minimum_size": 22}
