      "speaker_id": "dm-vishnu",
      "tail_max_length": 60,
      "text": "Then let the boon be this. Let both of you be overcome by me."
    },
    {
      "badge_number": 1,
      "box": {
        "height": 0.12,
        "width": 0.84,
        "x": 0.08,
        "y": 0.535
      },
