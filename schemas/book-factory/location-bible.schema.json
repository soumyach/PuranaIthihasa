{
  "$id": "https://khatakshetra.example/schemas/book-factory/location-bible.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "book_id": {"type": "string"},
    "entries": {"items": {"type": "object"}, "type": "array"},
    "kind": {"const": "LOCATION", "type": "string"},
    "version": {"minimum": 1, "type": "integer"}
  },
  "required": ["book_id", "version", "kind", "entries"],
  "title": "Location bible",
  "type": "object"
}
