{
  "$id": "https://khatakshetra.example/schemas/book-factory/source-readiness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "book_id": {"type": "string"},
    "claim_mappings": {"items": {"type": "object"}, "type": "array"},
    "graph_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "rules_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "status": {"enum": ["READY", "NEEDS_SOURCE_REVIEW", "INCOMPLETE_SOURCE", "BLOCKED"], "type": "string"},
    "story_spine_ids": {"items": {"type": "string"}, "type": "array"},
    "unresolved_flags": {"items": {"type": "object"}, "type": "array"}
  },
  "required": ["book_id", "status", "graph_hash", "rules_hash", "story_spine_ids", "claim_mappings", "unresolved_flags"],
  "title": "Source-readiness dossier",
  "type": "object"
}
