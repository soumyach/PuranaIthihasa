{
  "$id": "https://khatakshetra.example/schemas/book-factory/catalogue.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "books": {"items": {"$ref": "book-manifest.schema.json"}, "type": "array"},
    "collections": {"items": {"additionalProperties": true, "properties": {"id": {"type": "string"}, "title": {"type": "string"}}, "required": ["id", "title"], "type": "object"}, "type": "array"},
    "metadata": {"type": "object"},
    "schema_version": {"const": "1.0", "type": "string"}
  },
  "required": ["schema_version", "collections", "books"],
  "title": "Book Factory catalogue",
  "type": "object"
}
