{
  "$id": "https://khatakshetra.example/schemas/book-factory/illustration-proof-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "book_id": {"type": "string"},
    "proof_package_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "receipts": {"items": {"type": "object"}, "type": "array"},
    "validation": {"type": "object"}
  },
  "required": ["schema_version", "book_id", "proof_package_hash", "receipts", "validation"],
  "title": "Real illustration-proof execution snapshot",
  "type": "object"
}
