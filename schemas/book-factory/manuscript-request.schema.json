{
  "$id": "https://khatakshetra.example/schemas/book-factory/manuscript-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "book_id": {"type": "string"},
    "dossier_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "packet_hashes": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "minItems": 1, "type": "array"},
    "required_event_ids": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
    "request_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "operation_key": {"type": "string"}
  },
  "required": ["schema_version", "book_id", "dossier_hash", "packet_hashes", "required_event_ids", "request_hash", "operation_key"],
  "title": "Provider-bound manuscript request",
  "type": "object"
}
