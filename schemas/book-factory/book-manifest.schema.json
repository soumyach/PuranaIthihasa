{
  "$id": "https://khatakshetra.example/schemas/book-factory/book-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "collection_ids": {"items": {"type": "string"}, "type": "array"},
    "automatic_production_eligible": {"type": "boolean"},
    "edition_status": {"enum": ["PLANNED", "EXISTING_EDITION"], "type": "string"},
    "factory": {"type": "object"},
    "id": {"minLength": 1, "type": "string"},
    "line": {"enum": ["KATHAS", "ORIGINALS_KALPANA"], "type": "string"},
    "priority": {"minimum": 0, "type": "integer"},
    "readiness": {"enum": ["READY", "NEEDS_SOURCE_REVIEW", "INCOMPLETE_SOURCE", "BLOCKED", "COMPLETED"], "type": "string"},
    "source_class": {"enum": ["MULA", "SAMPRADAYA", "DRISHTI", "KALPANA"], "type": "string"},
    "title": {"minLength": 1, "type": "string"}
  },
  "required": ["id", "title", "line", "readiness", "collection_ids"],
  "title": "Book manifest",
  "type": "object"
}
