{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "page-composition.schema.json",
  "type": "object",
  "required": ["schema_version", "engine_version", "book_id", "book_version", "manuscript_hash", "storyboard_hash", "page_id", "page_number", "reading_order", "layout_type", "panels", "lettering", "required_lettering_ids", "composition_hash"],
  "properties": {
    "schema_version": {"type": "string"},
    "engine_version": {"type": "string"},
    "book_id": {"type": "string", "minLength": 1},
    "book_version": {"type": "string", "minLength": 1},
    "manuscript_hash": {"type": "string", "minLength": 16},
    "storyboard_hash": {"type": "string", "minLength": 16},
    "page_id": {"type": "string", "minLength": 1},
    "page_number": {"type": "integer", "minimum": 1},
    "reading_order": {"type": "integer", "minimum": 1},
    "layout_type": {"type": "string", "enum": ["TWO_PANEL_SEQUENTIAL", "THREE_PANEL", "FOUR_PANEL_GRID", "MIXED_WIDE_NARROW", "CINEMATIC_HERO", "SINGLE_PANEL_IMMERSIVE", "QUIET_NEAR_SILENT", "COVER", "REFLECTION_SOURCE_NOTE", "TWO_PAGE_SPREAD"]},
    "panels": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "lettering": {"type": "array", "items": {"type": "object"}},
    "required_lettering_ids": {"type": "array", "items": {"type": "string"}},
    "composition_hash": {"type": "string", "minLength": 16}
  }
}
