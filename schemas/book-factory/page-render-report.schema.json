{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "page-render-report.schema.json",
  "type": "object",
  "required": ["schema_version", "engine_version", "page_id", "result", "findings", "semantic_visual_review"],
  "properties": {
    "schema_version": {"type": "string"},
    "engine_version": {"type": "string"},
    "page_id": {"type": "string"},
    "result": {"type": "string", "enum": ["PASS", "FIX", "ESCALATE"]},
    "findings": {"type": "array", "items": {"type": "object"}},
    "semantic_visual_review": {"type": "object"}
  }
}
