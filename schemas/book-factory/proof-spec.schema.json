{
  "$id": "https://khatakshetra.example/schemas/book-factory/proof-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "book_id": {"type": "string"},
    "version": {"minimum": 1, "type": "integer"},
    "manuscript_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "storyboard_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "provider_status": {"enum": ["BLOCKED_PROVIDER", "AVAILABLE"], "type": "string"},
    "retry_limit": {"minimum": 1, "type": "integer"},
    "approval_records": {"items": {"type": "object"}, "type": "array"},
    "specs": {"items": {"type": "object"}, "minItems": 4, "type": "array"}
  },
  "required": ["schema_version", "book_id", "version", "manuscript_hash", "storyboard_hash", "provider_status", "retry_limit", "approval_records", "specs"],
  "title": "Versioned visual proof specifications",
  "type": "object"
}
