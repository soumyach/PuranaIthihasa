{
  "$id": "https://khatakshetra.example/schemas/book-factory/preproduction-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "book_id": {"type": "string"},
    "result": {"enum": ["PASS", "FIX", "ESCALATE"], "type": "string"},
    "component_reports": {"items": {"type": "object"}, "type": "array"},
    "semantic_visual_review": {"type": "object"},
    "publication_readiness_certified": {"const": false, "type": "boolean"}
  },
  "required": ["schema_version", "book_id", "result", "component_reports", "semantic_visual_review", "publication_readiness_certified"],
  "title": "Deterministic visual-preproduction review",
  "type": "object"
}
