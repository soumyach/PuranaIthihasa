{
  "$id": "https://khatakshetra.example/schemas/book-factory/artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string"},
    "input_hashes": {"items": {"type": "string"}, "type": "array"},
    "media_type": {"type": "string"},
    "path": {"type": "string"},
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "version": {"minimum": 1, "type": "integer"}
  },
  "required": ["id", "sha256", "media_type", "path", "input_hashes", "version"],
  "title": "Content-addressed artifact",
  "type": "object"
}
