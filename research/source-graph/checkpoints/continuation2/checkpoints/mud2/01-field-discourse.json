    {
      "id": "mud2-e-field-layout",
      "source_id": "gp-src-mudgala",
      "witness_id": "gp-wit-sd-mudgala-1",
      "passage_id": "mud2-p-field-layout",
      "locator": "Mudgala1.48.1–10",
      "paraphrase": "Śaunaka asks location and manifestation date. Sūta places Vakratunda at the eastern limit, installed by gods/sages/Gaṇas, manifest on Bhādra bright fourth; midday worship gives immense siddhis, beginning/end less. Images lie in each island/region’s east; square field ten yojanas, deity central with Siddhi left/Buddhi right, lion in front, eight siddhis in eight directions, eight Gaṇas and Śiva/Viṣṇu/Sun/Śakti in four directions.",
      "classification": "DIRECT_TEXT",
      "verification_status": "VERIFIED",
      "verifier": "Mudgala continuation2 author, direct Sanskrit body",
      "verification_notes": "Read actual cited body; attributed dialogue kept distinct from narrator fact. Independent root review pending."
    },
    {
      "id": "mud2-e-field-assembly",
      "source_id": "gp-src-mudgala",
      "witness_id": "gp-wit-sd-mudgala-1",
      "passage_id": "mud2-p-field-assembly",
      "locator": "Mudgala1.48.11–17",
      "paraphrase": "Brahmā and deities occupy east/behind, Gaṅgā and rivers south, Kāśī and fields west, Vasiṣṭha and sages north. Śeṣa/Nāga kings, Gandharvas, mountains, Siddhas, Apsarases, Vidyādharas and Kinnaras serve joyfully and exchange Vakratunda stories; bathing in the ocean they create tīrthas bearing their names.",
      "classification": "DIRECT_TEXT",
      "verification_status": "VERIFIED",
      "verifier": "Mudgala continuation2 author, direct Sanskrit body",
      "verification_notes": "Read actual cited body; attributed dialogue kept distinct from narrator fact. Independent root review pending."
    },
    {
      "id": "mud2-e-field-benefits",
      "source_id": "gp-src-mudgala",
      "witness_id": "gp-wit-sd-mudgala-1",
      "passage_id": "mud2-p-field-benefits",
      "locator": "Mudgala1.48.18–24",
      "paraphrase": "Gaṇeśa tīrtha bathing fulfils life; pilgrimage gives desired ends; dying in the field gives Brahman state. Distant remembrance gives enduring liberation by śukla-gati; devotees anywhere attain Brahman and purify people by sight. Sūta limits his account: even Śeṣa, Brahmā, Viṣṇu, Śiva, Vedas, Skanda and yogins cannot exhaust it, and he repeats Mudgala’s account to Dakṣa.",
      "classification": "DIRECT_TEXT",
      "verification_status": "VERIFIED",
      "verifier": "Mudgala continuation2 author, direct Sanskrit body",
      "verification_notes": "Read actual cited body; attributed dialogue kept distinct from narrator fact. Independent root review pending."
    }
