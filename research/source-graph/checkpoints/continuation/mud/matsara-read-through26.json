  "evidence": [
    {
      "id": "mud-e-coronation",
      "source_id": "gp-src-mudgala",
      "witness_id": "gp-wit-sd-mudgala-1",
      "passage_id": "mud-p-coronation",
      "locator": "Mudgala1.25.1–16",
      "paraphrase": "Mudgala tells Dakṣa the campaign’s purpose. Matsara and demons approach Śukra, request consecration as their king and receive his agreement. Named chiefs assemble; Veda-knowing Brahmins consecrate Matsara with Ṛg/Yajus/Sāman formulas, Uśanas directing the rites. The assembly rejoices and returns home.",
      "classification": "DIRECT_TEXT",
      "verification_status": "VERIFIED",
      "verifier": "Mudgala continuation author; direct Sanskrit reading",
      "verification_notes": "Direct reading of cited Sanskrit body. Independent language/edition check pending."
    },
    {
      "id": "mud-e-army",
      "source_id": "gp-src-mudgala",
      "witness_id": "gp-wit-sd-mudgala-1",
      "passage_id": "mud-p-army",
      "locator": "Mudgala1.25.17–44",
      "paraphrase": "Matsara summons the Asuras to conquer the three worlds. Fourfold forces muster with arms, trees, rocks and mountains: infantry, decorated elephants, swift horsemen, chariots and other animal mounts. His decorated chariot has one hundred asses; both sons ride horses ahead, Virocana and other chiefs around him.",
      "classification": "DIRECT_TEXT",
      "verification_status": "VERIFIED",
      "verifier": "Mudgala continuation author; direct Sanskrit reading",
      "verification_notes": "Direct reading of cited Sanskrit body. Independent language/edition check pending."
    },
    {
      "id": "mud-e-earth-conquest",
      "source_id": "gp-src-mudgala",
      "witness_id": "gp-wit-sd-mudgala-1",
      "passage_id": "mud-p-earth-conquest",
      "locator": "Mudgala1.26.1–9",
      "paraphrase": "Demon forces defeat terrestrial rulers: some flee, some surrender, warriors die fighting. Sons of dead rulers are installed as tributaries; surrendered kings retain office. Demons govern rulerless regions and are stationed beside local kings. Matsara rejoices after conquering the islanded earth.",
      "classification": "DIRECT_TEXT",
      "verification_status": "VERIFIED",
      "verifier": "Mudgala continuation author; direct Sanskrit reading",
      "verification_notes": "Direct reading of cited Sanskrit body. Independent language/edition check pending."
    },
    {
      "id": "mud-e-naga-battle",
      "source_id": "gp-src-mudgala",
      "witness_id": "gp-wit-sd-mudgala-1",
      "passage_id": "mud-p-naga-battle",
      "locator": "Mudgala1.26.10–32",
      "paraphrase": "Demons destroy Nāga gardens in Pātāla. Vāsuki, Takṣaka, Kambala and Aśvatara lead resistance: arms and missiles first repel demons; returning chiefs repel Nāgas. Serpent poison-flames burn demons, weapons and mounts; Śukra’s vidyā removes poison. A Garuḍa missile produces bird assailants, burnt by Vāsuki’s poison-fire. Virocana and chiefs themselves become Garuḍas by māyā and overwhelm Nāgas.",
      "classification": "DIRECT_TEXT",
      "verification_status": "VERIFIED",
      "verifier": "Mudgala continuation author; direct Sanskrit reading",
      "verification_notes": "Direct reading of cited Sanskrit body. Independent language/edition check pending."
    },
    {
      "id": "mud-e-naga-settlement",
      "source_id": "gp-src-mudgala",
      "witness_id": "gp-wit-sd-mudgala-1",
      "passage_id": "mud-p-naga-settlement",
      "locator": "Mudgala1.26.33–43",
      "paraphrase": "Śeṣa comes conciliating, asks why fellow Pātāla residents wage war, and addresses demons as brothers. Virocana demands submission to Matsara’s universal authority or destruction. Śeṣa agrees, offers annual tribute and jewels, withdraws with Vāsuki and others. Victorious demons march against Varuṇa.",
      "classification": "DIRECT_TEXT",
      "verification_status": "VERIFIED",
      "verifier": "Mudgala continuation author; direct Sanskrit reading",
      "verification_notes": "Direct reading of cited Sanskrit body. Independent language/edition check pending."
    }
  ],
